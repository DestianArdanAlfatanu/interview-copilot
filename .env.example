# API keys — backend only, never sent to the browser
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=

# Laragon MySQL (dev). In Docker Compose this is overridden to the mysql service.
DATABASE_URL=mysql://root@127.0.0.1:3306/interview_copilot

API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# Live answers
# claude (default) | mock — mock simulates answers locally, no Claude calls, no cost.
# Any value other than "mock" (or leaving it unset) uses Claude.
LIVE_LLM=claude
# Mock only: delay before the first simulated token
MOCK_FIRST_TOKEN_MS=700
LIVE_MODEL=claude-haiku-5-5
LIVE_EFFORT=low
# disabled | adaptive  (Haiku 5.5 thinks by default; disabled keeps first-token latency low)
LIVE_THINKING=disabled
LIVE_MAX_TOKENS=400
LIVE_CONTEXT_TURNS=12

# Prep analysis (M1)
PREP_MODEL=claude-sonnet-5-5

# Deepgram
DG_MODEL=nova-3
DG_ENDPOINTING_MS=300
DG_UTTERANCE_END_MS=1000
